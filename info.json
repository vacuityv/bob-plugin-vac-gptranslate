{
    "identifier": "me.vacuity.chat.gptranslate",
    "version": "2.3.0",
    "category": "translate",
    "name": "GPTranslate",
    "summary": "调用 openai-chatgpt/anthropic-claude/google-gemini/xai-grok/deepseek 实现翻译功能，支持流式输出",
    "icon": "",
    "author": "vacuity",
    "homepage": "",
    "appcast": "https://raw.githubusercontent.com/vacuityv/bob-plugin-vac-gptranslate/develop/appcast.json",
    "minBobVersion": "0.5.0",
    "options": [
        {
            "identifier": "server",
            "type": "menu",
            "title": "服务器",
            "defaultValue": "usa",
            "menuValues": [
                {
                    "title": "美国-切换后需重启",
                    "value": "usa"
                },
                {
                    "title": "国内-切换后需重启",
                    "value": "china"
                }
            ]
        },
        {
            "identifier": "loginAccount",
            "type": "text",
            "title": "登录邮箱"
        },
        {
            "identifier": "loginPassword",
            "type": "text",
            "title": "登录密码"
        },
        {
            "identifier": "modelType",
            "type": "menu",
            "title": "模型选择",
            "defaultValue": "gpt-6-sol",
            "menuValues": [
                {
                    "title": "gpt-6-astra",
                    "value": "gpt-6-astra"
                },
                {
                    "title": "gpt-6-sol",
                    "value": "gpt-6-sol"
                },
                {
                    "title": "gpt-5.6-terra",
                    "value": "gpt-5.6-terra"
                },
                {
                    "title": "gpt-6-luna",
                    "value": "gpt-6-luna"
                },
                {
                    "title": "claude-opus-5.5",
                    "value": "claude-opus-5.5"
                },
                {
                    "title": "claude-fable-5.1",
                    "value": "claude-fable-5.1"
                },
                {
                    "title": "claude-sonnet-5",
                    "value": "claude-sonnet-5"
                },
                {
                    "title": "gemini-3.8-flash",
                    "value": "gemini-3.8-flash"
                },
                {
                    "title": "gemini-3.1-pro",
                    "value": "gemini-3.1-pro"
                },
                {
                    "title": "grok-4.7",
                    "value": "grok-4.7"
                },
                {
                    "title": "deepseek-v4-flash",
                    "value": "deepseek-v4-flash"
                },
                {
                    "title": "deepseek-v4-pro",
                    "value": "deepseek-v4-pro"
                }
            ]
        },
        {
            "identifier": "useStreamFlag",
            "type": "menu",
            "title": "流式传输",
            "defaultValue": "y",
            "menuValues": [
                {
                    "title": "不使用",
                    "value": "n"
                },
                {
                    "title": "使用(需要版本>=1.8.0)",
                    "value": "y"
                }
            ]
        },
        {
            "identifier": "prompt",
            "type": "text",
            "title": "prompt",
            "textConfig": {
                "type": "visible",
                "height": 60,
                "placeholderText": "请输入您自定义的prompt（如果你不知道prompt是什么，请不要输入）"
            }
        }
    ]
}
